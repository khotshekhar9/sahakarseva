# SahakarSeva uses MySQL by default.
# Common local MySQL/XAMPP setup:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=contractor_erp_db

# Optional: override the full SQLAlchemy URL instead.
# DATABASE_URL=mysql+mysqlconnector://root:root@127.0.0.1:3306/contractor_erp_db?charset=utf8

# Optional external AI credentials. The built-in assistant works without them.
GEMINI_API_KEY=
GROK_API_KEY=
